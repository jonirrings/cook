{
  "name": "cook",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-types": "wrangler types",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "auth:generate": "pnpm dlx auth@latest generate --output src/db/auth.schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "wrangler d1 migrations apply cook-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply cook-db --local",
    "db:seed": "tsx drizzle/seed.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.38.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@fontsource/inter": "^5.1.1",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/refs": "^1.1.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/solid-form": "latest",
    "@tanstack/solid-query": "latest",
    "@tanstack/solid-query-devtools": "latest",
    "@tanstack/solid-router": "latest",
    "@tanstack/solid-router-devtools": "latest",
    "@tanstack/solid-start": "latest",
    "@tanstack/solid-store": "latest",
    "@tanstack/store": "latest",
    "better-auth": "^1.5.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.1.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-solid": "^8.6.0",
    "solid-js": "^1.9.12",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.133.21",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.70.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
