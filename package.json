{
  "name": "cook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-types": "wrangler types",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "auth:generate": "pnpm dlx auth@latest generate --output src/db/auth.schema.ts -y",
    "db:generate:local": "NODE_ENV=development drizzle-kit generate",
    "db:generate:remote": "NODE_ENV=production drizzle-kit generate",
    "db:migrate:mock": "NODE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "wrangler d1 migrations apply cook-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply cook-db --local"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.1",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@fontsource/inter": "^5.3.0",
    "@kobalte/core": "^0.13.13",
    "@solid-primitives/refs": "^1.1.4",
    "@tanstack/solid-devtools": "^0.8.12",
    "@tanstack/solid-form": "latest",
    "@tanstack/solid-form-devtools": "latest",
    "@tanstack/solid-query": "latest",
    "@tanstack/solid-query-devtools": "latest",
    "@tanstack/solid-router": "latest",
    "@tanstack/solid-router-devtools": "latest",
    "@tanstack/solid-start": "latest",
    "@tanstack/solid-store": "latest",
    "@tanstack/solid-table": "latest",
    "@tanstack/solid-table-devtools": "latest",
    "@tanstack/start-static-server-functions": "latest",
    "@tanstack/store": "latest",
    "better-auth": "^1.7.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-solid": "^8.6.0",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "latest",
    "@tanstack/eslint-plugin-router": "latest",
    "@tanstack/router-cli": "latest",
    "@tanstack/solid-router-ssr-query": "latest",
    "@types/node": "^26.4.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.129.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
