{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cook",
  "main": "@tanstack/solid-start/server-entry",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cook.jonirrings.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cook-db",
      "database_id": "9b012e37-6cca-4b25-9365-dd62439db57e",
      "migrations_dir": "drizzle"
    }
  ]
}