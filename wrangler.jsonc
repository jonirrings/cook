{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cook",
  "main": "@tanstack/solid-start/server-entry",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "BETTER_AUTH_URL": "https://cook.jonirrings.com"
  },
  "routes": [
    { "pattern": "cook.jonirrings.com", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/cook.webmanifest", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dinner-16.png", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dinner-64.png", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dinner-128.png", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dinner-192.png", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dinner-512.png", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/assets/*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/_serverFn/*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/api/*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/dashboard*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/categories*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/recipes*", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/forget-password", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/login", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/register", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/reset-password", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/health", "zone_name": "jonirrings.com" },
    { "pattern": "cook.jonirrings.com/lucky", "zone_name": "jonirrings.com" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cook-db",
      "database_id": "9b012e37-6cca-4b25-9365-dd62439db57e",
      "migrations_dir": "drizzle"
    }
  ]
}